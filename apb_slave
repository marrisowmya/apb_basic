module apb_slave #(
    parameter ADDR_WIDTH = 32,
    parameter DATA_WIDTH = 32
)(
    input  logic                  PCLK,
    input  logic                  PRESETn,

    input  logic [ADDR_WIDTH-1:0] PADDR,
    input  logic                  PSEL,
    input  logic                  PENABLE,
    input  logic                  PWRITE,
    input  logic [DATA_WIDTH-1:0] PWDATA,

    output logic [DATA_WIDTH-1:0] PRDATA,
    output logic                  PREADY,
    output logic                  PSLVERR
);

    //========================================================
    // Peripheral registers
    //========================================================

    logic [DATA_WIDTH-1:0] ctrl_reg;
    logic [DATA_WIDTH-1:0] status_reg;
    logic [DATA_WIDTH-1:0] data_reg;
    logic [DATA_WIDTH-1:0] config_reg;


    //========================================================
    // Write operation
    //========================================================

    always_ff @(posedge PCLK or negedge PRESETn) begin

        if (!PRESETn) begin

            ctrl_reg   <= '0;
            status_reg <= '0;
            data_reg   <= '0;
            config_reg <= '0;

        end

        else if (PSEL && PENABLE && PWRITE) begin

            case (PADDR)

                32'h0000_0000:
                    ctrl_reg <= PWDATA;

                32'h0000_0008:
                    data_reg <= PWDATA;

                32'h0000_000C:
                    config_reg <= PWDATA;

                // STATUS is read-only
                32'h0000_0004:
                    ;

                default:
                    ;

            endcase

        end

    end


    //========================================================
    // Read operation
    //========================================================

    always_comb begin

        PRDATA = '0;

        if (PSEL && PENABLE && !PWRITE) begin

            case (PADDR)

                32'h0000_0000:
                    PRDATA = ctrl_reg;

                32'h0000_0004:
                    PRDATA = status_reg;

                32'h0000_0008:
                    PRDATA = data_reg;

                32'h0000_000C:
                    PRDATA = config_reg;

                default:
                    PRDATA = '0;

            endcase

        end

    end


    //========================================================
    // Ready response
    //========================================================

    always_comb begin

        PREADY = 1'b0;

        if (PSEL && PENABLE)
            PREADY = 1'b1;

    end


    //========================================================
    // Error response
    //========================================================

    always_comb begin

        PSLVERR = 1'b0;

        if (PSEL && PENABLE) begin

            case (PADDR)

                32'h0000_0000,
                32'h0000_0008,
                32'h0000_000C:

                    PSLVERR = 1'b0;


                // STATUS is read-only
                32'h0000_0004:

                    PSLVERR = PWRITE;


                // Invalid address
                default:

                    PSLVERR = 1'b1;

            endcase

        end

    end

endmodule
